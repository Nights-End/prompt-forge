# Dependencies
node_modules/

# Build output
dist/
build/

# SQLite data (persisted via Docker volume)
apps/api/data/*.db
apps/api/data/*.db-*

# Uploaded asset files (persisted via Docker volume)
apps/api/data/uploads/

# Local provider config (contains API keys; never commit)
apps/api/data/provider.json

# Local search provider config (contains API keys; never commit)
apps/api/data/search.json

# Local workshop runtime config (default extra prompt, custom presets)
apps/api/data/workshop.json

# Local prompts config (default category)
apps/api/data/prompts.json

# /api/ext boundary config (origin allow-list + token hash; never commit)
apps/api/data/ext.json

# Plaintext shared token for the SillyTavern extension (never commit)
apps/api/data/ext-token.txt

# Logs
*.log
npm-debug.log*

# Env
.env
.env.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

.kilo/
.kilocode/

.temp/