{
  "name": "prompt-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:api": "pnpm --filter @prompt-forge/api dev",
    "dev:web": "pnpm --filter @prompt-forge/web dev",
    "build": "pnpm --filter @prompt-forge/shared build && pnpm --filter @prompt-forge/api build && pnpm --filter @prompt-forge/web build",
    "start": "pnpm --filter @prompt-forge/api start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
